dOffsetZ":0.0,"gridColor":10401023.0,"gridAlpha":0.8,"snap":false,"zoomFactor":0.7291666666666666,"windowMask":false,"selectedLayer":"","gameEditorMode":"instances-editor"},"objectsGroups":[],"variables":[],"instances":[{"angle":0.0,"customSize":false,"height":0.0,"keepRatio":true,"layer":"","name":"GameOverText","persistentUuid":"5005b268-4375-4723-bf35-2417af961919","width":0.0,"x":209.0,"y":148.0,"zOrder":1,"numberProperties":[],"stringProperties":[],"initialVariables":[]}],"objects":[{"assetStoreId":"","bold":false,"italic":false,"name":"GameOverText","persistentUuid":"a87d2c5b-dcaf-4732-b600-672ba7ef19e0","smoothed":true,"type":"TextObject::Text","underlined":false,"variables":[],"effects":[],"behaviors":[],"string":"POWER DEPLETED\n\nYour battery has run out.","font":"","textAlignment":"left","characterSize":50.0,"color":{"b":37,"g":6,"r":255},"content":{"bold":false,"isOutlineEnabled":false,"isShadowEnabled":false,"italic":false,"outlineColor":"255;255;255","outlineThickness":2.0,"shadowAngle":90.0,"shadowBlurRadius":2.0,"shadowColor":"0;0;0","shadowDistance":4.0,"shadowOpacity":127.0,"smoothed":true,"underlined":false,"text":"POWER DEPLETED\n\nYour battery has run out.","font":"","textAlignment":"left","verticalTextAlignment":"top","characterSize":50.0,"lineHeight":0.0,"color":"255;6;37"}}],"objectsFolderStructure":{"folderName":"__ROOT","children":[{"objectName":"GameOverText"}]},"events":[],"layers":[{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":3.0,"cameraType":"","followBaseLayerCamera":false,"isLightingLayer":false,"isLocked":false,"name":"","renderingType":"","visibility":true,"cameras":[{"defaultSize":true,"defaultViewport":true,"height":0.0,"viewportBottom":1.0,"viewportLeft":0.0,"viewportRight":1.0,"viewportTop":0.0,"width":0.0}],"effects":[{"effectType":"Scene3D::HemisphereLight","name":"3D Ambient Hemisphere Light","doubleParameters":{"elevation":40.0,"intensity":0.33,"rotation":300.0},"stringParameters":{"groundColor":"127;127;127","skyColor":"255;255;255","top":"Z+"},"booleanParameters":{}},{"effectType":"Scene3D::DirectionalLight","name":"3D Sun Light","doubleParameters":{"distanceFromCamera":1500.0,"elevation":40.0,"frustumSize":4000.0,"intensity":0.75,"minimumShadowBias":0.0,"rotation":300.0,"shadowDistance":2000.0,"shadowNormalBias":1.0},"stringParameters":{"color":"255;255;255","shadowQuality":"medium","shadowRenderingMode":"fittedToCameraView","top":"Z+"},"booleanParameters":{"isCastingShadow":true}}]}],"behaviorsSharedData":[{"name":"Effect","type":"EffectCapability::EffectBehavior"},{"name":"Opacity","type":"OpacityCapability::OpacityBehavior"},{"name":"Scale","type":"ScalableCapability::ScalableBehavior"},{"name":"Text","type":"TextContainerCapability::TextContainerBehavior"}]}],"layoutsFolderStructure":{"folderName":"__ROOT","children":[{"itemName":"Level01"},{"itemName":"GameOver"}]},"externalEvents":[],"externalEventsFolderStructure":{"folderName":"__ROOT"},"tests":[{"description":"Player falls onto the floor, walks left/right with arrows and A/D, and jumps with Space reaching a clear height.","lastRunAt":1794270187803.0,"lastRunDurationMs":327.0,"lastRunFramesExecuted":289,"lastRunStatus":"passed","name":"Player platformer controls","type":"gameplay","source":["await harness.goToScene('Untitled scene');","await harness.stepFrames(60);","","const p0 = harness.getObjects('Player')[0];","harness.assert(!!p0, 'Player exists in the scene');","","// Gravity: the player should be resting on the floor (not falling forever)","const yStart = harness.getObjects('Player')[0].y;","await harness.stepFrames(30);","const ySettled = harness.getObjects('Player')[0].y;","harness.assert(Math.abs(ySettled - yStart) < 2, 'Player settled on the floor (gravity + ground collision), y=' + ySettled);","","// Move right with arrow key","const startX = harness.getObjects('Player')[0].x;","harness.setKeyPressed('Right', true);","await harness.stepFrames(45);","harness.setKeyPressed('Right', false);","const rightX = harness.getObjects('Player')[0].x;","harness.assert(rightX > startX + 40, 'Right arrow moved the player right (' + startX.toFixed(0) + ' -> ' + rightX.toFixed(0) + ')');","","// Move left with A key","harness.setKeyPressed('a', true);","await harness.stepFrames(45);","harness.setKeyPressed('a', false);","const leftX = harness.getObjects('Player')[0].x;","harness.assert(leftX < rightX - 40, 'A key moved the player left (' + rightX.toFixed(0) + ' -> ' + leftX.toFixed(0) + ')');","","// Jump with Space","await harness.stepFrames(20);","const beforeJumpY = harness.getObjects('Player')[0].y;","harness.setKeyPressed('Space', true);","await harness.stepFrames(3);","const risingY = harness.getObjects('Player')[0].y;","let peakY = risingY;","for (let i = 0; i < 30; i++) { await harness.stepFrames(1); peakY = Math.min(peakY, harness.getObjects('Player')[0].y); }","harness.setKeyPressed('Space', false);","harness.assert(peakY < beforeJumpY - 60, 'Space made the player jump up (y ' + beforeJumpY.toFixed(0) + ' -> peak ' + peakY.toFixed(0) + ')');","","// And it comes back down (gravity)","const landed = await harness.stepUntil(() => { const p = harness.getObjects('Player')[0]; return p && Math.abs(p.y - beforeJumpY) < 3; }, { maxFrames: 300 });","harness.assert(landed, 'Player fell back down and landed on the floor');","","// Walk animation switches while moving","harness.setKeyPressed('d', true);","await harness.stepFrames(20);","const walking = harness.getObjects('Player')[0].animation;","harness.setKeyPressed('d', false);","await harness.stepFrames(20);","const idle = harness.getObjects('Player')[0].animation;","harness.assert(walking === 'Walk', 'Player plays the Walk animation while moving (got ' + walking + ')');","harness.assert(idle === 'Idle', 'Player plays the Idle animation when standing (got ' + idle + ')');","","await harness.takeScreenshot('player on ground');",""]},{"description":"Verifies Idle/Walk/Run/Jump animation states and that sprint (Shift) is faster than walk.","lastRunAt":1794279189593.0,"lastRunDurationMs":289.0,"lastRunFramesExecuted":158,"lastRunStatus":"passed","name":"Player animation states","type":"gameplay","source":["await harness.goToScene('Level01');","await harness.stepFrames(30);","const player = () => harness.getObjects('Player')[0];","const anim = () => player() && player().animation;","","// Idle on floor","harness.assert(anim() === 'Idle', 'Idle on floor, not moving (got ' + anim() + ')');","","// Walk","harness.setKeyPressed('Right', true);","await harness.stepFrames(20);","harness.assert(anim() === 'Walk', 'Walk while moving without Shift (got ' + anim() + ')');","const walkX = player().x;","","// Run with Shift","harness.setKeyPressed('LShift', true);","await harness.stepFrames(20);","harness.assert(anim() === 'Run', 'Run while moving with Shift (got ' + anim() + ')');","const runX = player().x;","harness.setKeyPressed('LShift', false);","","// Jump overrides ground animations","harness.setKeyPressed('Space', true);","await harness.stepFrames(2);","harness.setKeyPressed('Space', false);","await harness.stepFrames(5);","harness.assert(anim() === 'Jump', 'Jump animation while airborne (got ' + anim() + ')');","harness.setKeyPressed('Right', false);","await harness.stepUntil(() => player().behaviors.PlatformerObject && player().behaviors.PlatformerObject.state.IsOnFloor, { maxFrames: 300 });","harness.assert(anim() === 'Idle', 'Back to Idle after landing (got ' + anim() + ')');","","// Sprint actually moves faster","harness.setKeyPressed('Right', true);","await harness.stepFrames(30);","const x1 = player().x;","harness.setKeyPressed('LShift', true);","await harness.stepFrames(30);","const x2 = player().x;","harness.setKeyPressed('Right', false);","harness.setKeyPressed('LShift', false);","const walkSpeed = (x1 - walkX) / 0.5, runSpeed = (x2 - runX) / 0.5;","harness.assert(runSpeed > walkSpeed * 1.2, 'Sprint is faster: walk ' + walkSpeed.toFixed(0) + ' px/s vs run ' + runSpeed.toFixed(0) + ' px/s');","await harness.takeScreenshot('animation states');"]}],"testsFolderStructure":{"folderName":"__ROOT","children":[{"itemName":"Player platformer controls"},{"itemName":"Player animation states"}]},"eventsFunctionsExtensions":[],"externalLayouts":[],"externalLayoutsFolderStructure":{"folderName":"__ROOT"}}