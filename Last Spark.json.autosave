true,"cameras":[],"effects":[{"effectType":"Scene3D::HemisphereLight","name":"3D Ambient Hemisphere Light","doubleParameters":{"elevation":40.0,"intensity":0.33,"rotation":300.0},"stringParameters":{"groundColor":"127;127;127","skyColor":"255;255;255","top":"Z+"},"booleanParameters":{}},{"effectType":"Scene3D::DirectionalLight","name":"3D Sun Light","doubleParameters":{"distanceFromCamera":1500.0,"elevation":40.0,"frustumSize":4000.0,"intensity":0.75,"minimumShadowBias":0.0,"rotation":300.0,"shadowDistance":2000.0,"shadowNormalBias":1.0},"stringParameters":{"color":"255;255;255","shadowQuality":"medium","shadowRenderingMode":"fittedToCameraView","top":"Z+"},"booleanParameters":{"isCastingShadow":true}}]}],"behaviorsSharedData":[{"name":"Effect","type":"EffectCapability::EffectBehavior"},{"name":"Opacity","type":"OpacityCapability::OpacityBehavior"},{"name":"Scale","type":"ScalableCapability::ScalableBehavior"},{"name":"Text","type":"TextContainerCapability::TextContainerBehavior"}]}],"layoutsFolderStructure":{"folderName":"__ROOT","children":[{"itemName":"Level01"},{"itemName":"GameOver"},{"itemName":"Victory"}]},"externalEvents":[],"externalEventsFolderStructure":{"folderName":"__ROOT"},"tests":[{"description":"Player falls onto the floor, walks left/right with arrows and A/D, and jumps with Space reaching a clear height.","lastRunAt":1794530198467.0,"lastRunDurationMs":570.0,"lastRunFramesExecuted":483,"lastRunStatus":"passed","name":"Player platformer controls","type":"gameplay","source":["await harness.goToScene('Level01');","const probes = await harness.resetSceneAndProbeControls('Player', ['Left', 'Right', 'a', 'd', 'Space']);","console.log('Control probes: ' + JSON.stringify(probes));","await harness.stepFrames(60);","","const p0 = harness.getObjects('Player')[0];","harness.assert(!!p0, 'Player exists in the scene');","","// Gravity: the player should be resting on the floor (not falling forever)","const yStart = harness.getObjects('Player')[0].y;","await harness.stepFrames(30);","const ySettled = harness.getObjects('Player')[0].y;","harness.assert(Math.abs(ySettled - yStart) < 2, 'Player settled on the floor (gravity + ground collision), y=' + ySettled);","","// Move right with arrow key","const startX = harness.getObjects('Player')[0].x;","harness.setKeyPressed('Right', true);","await harness.stepFrames(45);","harness.setKeyPressed('Right', false);","const rightX = harness.getObjects('Player')[0].x;","harness.assert(rightX > startX + 40, 'Right arrow moved the player right (' + startX.toFixed(0) + ' -> ' + rightX.toFixed(0) + ')');","","// Move left with A key","harness.setKeyPressed('a', true);","await harness.stepFrames(45);","harness.setKeyPressed('a', false);","const leftX = harness.getObjects('Player')[0].x;","harness.assert(leftX < rightX - 40, 'A key moved the player left (' + rightX.toFixed(0) + ' -> ' + leftX.toFixed(0) + ')');","","// Jump with Space","await harness.stepFrames(20);","const beforeJumpY = harness.getObjects('Player')[0].y;","harness.setKeyPressed('Space', true);","await harness.stepFrames(3);","const risingY = harness.getObjects('Player')[0].y;","let peakY = risingY;","for (let i = 0; i < 30; i++) { await harness.stepFrames(1); peakY = Math.min(peakY, harness.getObjects('Player')[0].y); }","harness.setKeyPressed('Space', false);","harness.assert(peakY < beforeJumpY - 60, 'Space made the player jump up (y ' + beforeJumpY.toFixed(0) + ' -> peak ' + peakY.toFixed(0) + ')');","","// And it comes back down (gravity)","const landed = await harness.stepUntil(() => { const p = harness.getObjects('Player')[0]; return p && Math.abs(p.y - beforeJumpY) < 3; }, { maxFrames: 300 });","harness.assert(landed, 'Player fell back down and landed on the floor');","","// Walk animation switches while moving","harness.setKeyPressed('d', true);","await harness.stepFrames(20);","const walking = harness.getObjects('Player')[0].animation;","harness.setKeyPressed('d', false);","await harness.stepFrames(20);","const idle = harness.getObjects('Player')[0].animation;","harness.assert(walking === 'Walk', 'Player plays the Walk animation while moving (got ' + walking + ')');","harness.assert(idle === 'Idle', 'Player plays the Idle animation when standing (got ' + idle + ')');","","await harness.takeScreenshot('player on ground');"]},{"description":"Verifies Idle/Walk/Run/Jump animation states and that sprint (Shift) is faster than walk, staying on the shortened starting floor.","lastRunAt":1794612475441.0,"lastRunDurationMs":415.0,"lastRunFramesExecuted":137,"lastRunStatus":"passed","name":"Player animation states","type":"gameplay","source":["await harness.goToScene('Level01');","const settled = await harness.stepUntil(() => {","  const p = harness.getObjects('Player')[0];","  const bh = p && p.behaviors.PlatformerObject;","  return !!bh && bh.state.IsOnFloor === true && Math.abs(p.y - 389) < 6;","}, { maxFrames: 240 });","harness.assert(settled, 'player settled on the starting floor');","const anim = () => (harness.getObjects('Player')[0] || {}).animation;","harness.assert(anim() === 'Idle', 'Idle on the floor, not moving (got ' + anim() + ')');","","// walk (no shift) — kept short so the player stays on the shortened starting floor (ends at x=539)","const x0 = harness.getObjects('Player')[0].x;","harness.setKeyPressed('Right', true);","await harness.stepFrames(18);","harness.assert(anim() === 'Walk', 'Walk while moving without Shift (got ' + anim() + ')');","const x1 = harness.getObjects('Player')[0].x;","","// run with shift","harness.setKeyPressed('LShift', true);","await harness.stepFrames(18);","harness.assert(anim() === 'Run', 'Run while moving with Shift (got ' + anim() + ')');","const x2 = harness.getObjects('Player')[0].x;","harness.setKeyPressed('LShift', false);","","const walkSpeed = (x1 - x0) / (18 / 60), runSpeed = (x2 - x1) / (18 / 60);","harness.assert(x2 < 520, 'player stayed on the starting floor while sprinting (x=' + x2.toFixed(0) + ')');","harness.assert(runSpeed > walkSpeed * 1.2, 'Sprint is faster: walk ' + walkSpeed.toFixed(0) + ' px/s vs run ' + runSpeed.toFixed(0) + ' px/s');","","// jump overrides ground animations (released keys first so the player does not drift off the floor)","harness.setKeyPressed('Right', false);","await harness.stepFrames(12);","harness.assert(anim() === 'Idle', 'Idle again after releasing the movement keys (got ' + anim() + ')');","harness.setKeyPressed('Space', true);","await harness.stepFrames(2);","harness.setKeyPressed('Space', false);","await harness.stepFrames(5);","harness.assert(anim() === 'Jump', 'Jump animation while airborne (got ' + anim() + ')');","","const landed = await harness.stepUntil(() => {","  const p = harness.getObjects('Player')[0];","  const bh = p && p.behaviors.PlatformerObject;","  return !!bh && bh.state.IsOnFloor === true;","}, { maxFrames: 300 });","harness.assert(landed, 'player landed after the jump');","await harness.stepFrames(6);","harness.assert(anim() === 'Idle', 'Back to Idle after landing (got ' + anim() + ')');","harness.assert(harness.getSceneName() === 'Level01', 'no fall occurred during the animation checks');","await harness.takeScreenshot('animation states');",""]},{"description":"The pickup on the floating platform is reachable, collected on collision, and only that one pickup is consumed; battery stays in 0..100.","lastRunAt":1794614451800.0,"lastRunDurationMs":776.0,"lastRunFramesExecuted":331,"lastRunStatus":"failed","name":"Energy pickup collection","type":"gameplay","source":["await harness.goToScene('Level01');","await harness.stepFrames(30);","const pickups = harness.getObjects('EnergyPickup');","harness.assert(pickups.length === 3, 'three pickups present in Level01 (found ' + pickups.length + ')');","const target = pickups.find(p => Math.abs(p.x - 625) < 6);","harness.assert(!!target, 'pickup at (625,287) exists');","harness.assert(!!target && target.y > 280 && target.y < 340, 'pickup sits just above the floating platform (top y=' + (target && target.y) + ')');","","const before = pickups.length;","const player = harness.getObjects('Player')[0];","harness.setObjectPosition(player.id, 520, 200); // above the floating platform, left of the pickup","const landed = await harness.stepUntil(() => {","  const p = harness.getObjects('Player')[0];","  const bh = p && p.behaviors.PlatformerObject;","  return !!bh && bh.state.IsOnFloor === true && Math.abs(p.y - 240) < 8;","}, { maxFrames: 300 });","const playerAfterLanding = harness.getObjects('Player')[0];","harness.assert(landed, 'player landed on the floating platform (y=' + (playerAfterLanding ? playerAfterLanding.y.toFixed(0) : 'missing after scene change') + ')');","","harness.setKeyPressed('Right', true);","const collected = await harness.stepUntil(() => harness.getObjects('EnergyPickup').length < before, { maxFrames: 300 });","harness.setKeyPressed('Right', false);","await harness.stepFrames(5);","harness.assert(collected, 'walking into the pickup collected it (deleted)');","harness.assert(harness.getObjects('EnergyPickup').length === before - 1, 'exactly one pickup consumed (left ' + harness.getObjects('EnergyPickup').length + ')');","const battery = harness.getSceneVariable('Battery');","harness.assert(!!battery && Number(battery.value) >= 0 && Number(battery.value) <= 100, 'battery stays within 0..100 (value=' + (battery && battery.value) + ')');","await harness.takeScreenshot('after collection');",""]},{"description":"Camera follows the Player horizontally with clamped bounds (480 / 3720 through LevelWidth) and the HUD stays on the fixed UI layer.","lastRunAt":1794614483366.0,"lastRunDurationMs":602.0,"lastRunFramesExecuted":158,"lastRunStatus":"passed","name":"Camera follow and HUD","type":"gameplay","source":["await harness.goToScene('Level01');","await harness.stepFrames(30);","const hud = harness.getObjects('BatteryText')[0];","harness.assert(!!hud && !hud.hidden && hud.layer === 'UI', 'BatteryText visible on UI layer');","let cam = harness.getCameraState('');","harness.assert(Math.abs(cam.x - 480) < 2, 'Camera clamped at left boundary (x=' + cam.x + ')');","harness.assert(Math.abs(cam.y - 400) < 2, 'Camera Y starts at 400 (y=' + cam.y + ')');","const p = harness.getObjects('Player')[0];","harness.setObjectPosition(p.id, 1100, 60);","const followed = await harness.stepUntil(() => {","  const c = harness.getCameraState('');","  const pl = harness.getObjects('Player')[0];","  return Math.abs(c.x - pl.centerX) < 3;","}, { maxFrames: 120 });","cam = harness.getCameraState('');","const mid = harness.getObjects('Player')[0];","harness.assert(followed, 'Camera follows player in the middle (cam.x=' + Math.round(cam.x) + ', center=' + Math.round(mid.centerX) + ')');","harness.assert(cam.y >= 130 && cam.y <= 400, 'Camera Y stays inside its clamped range (y=' + cam.y.toFixed(0) + ')');","// right end of the CURRENT layout: the camera follows (the clamp moved to LevelWidth-480 = 3720)","harness.setObjectPosition(p.id, 1840, 300);","await harness.stepFrames(90);","cam = harness.getCameraState('');","const end = harness.getObjects('Player')[0];","const expected = Math.min(Math.max(end.centerX, 480), 3720);","harness.assert(Math.abs(cam.x - expected) < 4, 'Camera follows to the right end of the current platforms (cam=' + Math.round(cam.x) + ', expected=' + Math.round(expected) + ')');","harness.assert(cam.x <= 3721, 'Camera never exceeds the new 4200-480 = 3720 clamp (x=' + Math.round(cam.x) + ')');","harness.assert(!harness.getObjects('BatteryText')[0].hidden, 'BatteryText still visible after scroll');","await harness.takeScreenshot('camera at final platform');",""]},{"description":"Vertical dead-zone camera within its clamps: no bounce on small jumps, follows the player up (never above 130) on the high platform, returns to 400 after landing on the floor, horizontal follow correct, HUD fixed.","lastRunAt":1794614416392.0,"lastRunDurationMs":537.0,"lastRunFramesExecuted":312,"lastRunStatus":"passed","name":"Vertical camera dead zone","type":"gameplay","source":["await harness.goToScene('Level01');","await harness.stepFrames(90);","let cam = harness.getCameraState('');","const startY = cam.y;","const p = harness.getObjects('Player')[0];","harness.assert(Math.abs(startY - 400) < 2, 'camera settled at Y=400 on the starting floor (y=' + startY.toFixed(0) + ')');","","// Small jump: dead zone, no camera movement","harness.setKeyPressed('Space', true);","await harness.stepFrames(10);","harness.setKeyPressed('Space', false);","await harness.stepFrames(60);","cam = harness.getCameraState('');","harness.assert(Math.abs(cam.y - startY) < 2, 'Small jump does not move camera Y (y=' + cam.y.toFixed(0) + ')');","","// High platform B (top 190): camera follows UP but never past its upper bound 130","harness.setObjectPosition(p.id, 1150, 100);","await harness.stepFrames(60);","cam = harness.getCameraState('');","harness.assert(cam.y < startY - 20, 'Camera moved UP on the high platform (y=' + Math.round(cam.y) + ')');","harness.assert(cam.y >= 128, 'Camera Y respects the upper bound 130 (y=' + cam.y.toFixed(1) + ')');","const highPlayer = harness.getObjects('Player')[0];","harness.assert(highPlayer.centerY >= cam.y - 271 && highPlayer.centerY <= cam.y + 271, 'Player stays inside the vertical viewport on the high platform');","","// Back to the floor: drop the player just ABOVE the surface (feet clear of the slab) and let it land","harness.setObjectPosition(p.id, 400, 380);","const landed = await harness.stepUntil(() => {","  const q = harness.getObjects('Player')[0];","  const bh = q && q.behaviors.PlatformerObject;","  return !!bh && bh.state.IsOnFloor === true && Math.abs(q.y - 389) < 8;","}, { maxFrames: 240 });","harness.assert(landed, 'player landed back on the starting floor (y=' + harness.getObjects('Player')[0].y.toFixed(0) + ')');","harness.assert(harness.getSceneName() === 'Level01', 'no fall occurred (scene=' + harness.getSceneName() + ')');","await harness.stepFrames(90);","cam = harness.getCameraState('');","harness.assert(cam.y >= startY - 2 && cam.y <= 401, 'Back at lower bound 400 on the floor (y=' + cam.y.toFixed(0) + ')');","","const low = harness.getObjects('Player')[0];","const expectedX = Math.min(Math.max(low.centerX, 480), 3720);","harness.assert(Math.abs(cam.x - expectedX) < 4, 'Horizontal follow unchanged (cam=' + Math.round(cam.x) + ', expected=' + Math.round(expectedX) + ')');","","const hud = harness.getObjects('BatteryText')[0];","harness.assert(!!hud && !hud.hidden && hud.layer === 'UI', 'BatteryText still fixed on UI layer');","await harness.takeScreenshot('high platform framing');",""]},{"description":"Smoothed camera: direction changes with the camera unclamped, full jump arc from the highest platform M8 fully visible, descent to the floor, horizontal clamp 3720 via LevelWidth, HUD fixed.","lastRunAt":1794614622328.0,"lastRunDurationMs":950.0,"lastRunFramesExecuted":562,"lastRunStatus":"passed","name":"Smoothed camera and jump arc visibility","type":"gameplay","source":["await harness.goToScene('Level01');","await harness.stepFrames(90);","","// 1. Direction change on M10 (2440..2660, top 390) where the camera is unclamped","const p = harness.getObjects('Player')[0];","harness.setObjectPosition(p.id, 2540, 300);","await harness.stepFrames(70);","const landedM10 = harness.getObjects('Player')[0];","harness.assert(Math.abs(landedM10.y - 304) < 10, 'player landed on M10 (y=' + landedM10.y.toFixed(0) + ')');","const camStart = harness.getCameraState('').x;","harness.assert(Math.abs(camStart - landedM10.centerX) < 6, 'camera centred on the player before the walk (cam=' + Math.round(camStart) + ')');","harness.setKeyPressed('Right', true);","await harness.stepFrames(12);","harness.setKeyPressed('Right', false);","await harness.stepFrames(15);","const camAfterRight = harness.getCameraState('').x;","harness.setKeyPressed('Left', true);","await harness.stepFrames(16);","harness.setKeyPressed('Left', false);","await harness.stepFrames(15);","const camAfterLeft = harness.getCameraState('').x;","harness.assert(harness.getSceneName() === 'Level01', 'player never fell during the direction test');","harness.assert(camAfterRight > camStart + 5, 'Camera followed right (x ' + Math.round(camStart) + ' -> ' + Math.round(camAfterRight) + ')');","harness.assert(camAfterLeft < camAfterRight - 5, 'Camera moved back left after direction change (right=' + Math.round(camAfterRight) + ', left=' + Math.round(camAfterLeft) + ')');","let prev = null, maxJump = 0;","for (let i = 0; i < 20; i++) {","  await harness.stepFrames(1);","  const cx = harness.getCameraState('').x;","  if (prev !== null) maxJump = Math.max(maxJump, Math.abs(cx - prev));","  prev = cx;","}","harness.assert(maxJump < 12, 'No abrupt horizontal snapping (max per-frame move=' + maxJump.toFixed(1) + 'px)');","","// 2. Full jump arc from the highest platform M8 (1920..2005, top 165)","await harness.goToScene('Level01');","await harness.stepFrames(20);","const p2 = harness.getObjects('Player')[0];","harness.setObjectPosition(p2.id, 1930, 100);","await harness.stepFrames(60);","const onM8 = harness.getObjects('Player')[0];","harness.assert(Math.abs(onM8.y - 79) < 10, 'player landed on M8 (y=' + onM8.y.toFixed(0) + ')');","let minY = 9999, minVisibleTop = 9999;","harness.setKeyPressed('Space', true);","for (let i = 0; i < 75; i++) {","  await harness.stepFrames(1);","  if (i === 12) harness.setKeyPressed('Space', false);","  const q = harness.getObjects('Player')[0];","  const c = harness.getCameraState('');","  const topOnScreen = q.centerY - q.height / 2 - (c.y - 270);","  minY = Math.min(minY, q.y);","  minVisibleTop = Math.min(minVisibleTop, topOnScreen);","}","harness.setKeyPressed('Space', false);","console.log('M8 apex player y=' + Math.round(minY) + ', best sprite-top screen y=' + Math.round(minVisibleTop));","harness.assert(minY < 60, 'Player reached the full jump arc above M8 (min y=' + Math.round(minY) + ')');","harness.assert(minVisibleTop >= 0, 'ENTIRE sprite stayed on screen at apex (best sprite-top screen y=' + Math.round(minVisibleTop) + 'px)');","","// 3. Back to the floor: camera descends, bounds respected","await harness.stepFrames(60);","const c2 = harness.getCameraState('');","const q2 = harness.getObjects('Player')[0];","harness.assert(q2.behaviors.PlatformerObject.state.IsOnFloor === true, 'Player landed back on M8');","harness.setObjectPosition(q2.id, 400, 380);","await harness.stepFrames(70);","const c3 = harness.getCameraState('');","harness.assert(harness.getSceneName() === 'Level01', 'player stayed in the scene when descending to the floor');","harness.assert(c3.y > c2.y, 'Camera descended (y ' + Math.round(c2.y) + ' -> ' + Math.round(c3.y) + ')');","harness.assert(c3.y <= 401, 'Lower bound 400 respected (y=' + c3.y + ')');","","// 4. Right clamp still LevelWidth-480 = 3720","const p4 = harness.getObjects('Player')[0];","harness.setObjectPosition(p4.id, 3900, -200);","const reached = await harness.stepUntil(() => Math.abs(harness.getCameraState('').x - 3720) < 4, { maxFrames: 70 });","const c4 = harness.getCameraState('');","harness.assert(reached && c4.x <= 3721, 'Camera clamps at 4200-480 = 3720 (x=' + c4.x.toFixed(0) + ')');","","const hud = harness.getObjects('BatteryText')[0];","harness.assert(!!hud && !hud.hidden && hud.layer === 'UI', 'BatteryText still fixed on UI layer');","await harness.takeScreenshot('after jump arc from M8');",""]},{"description":"Victory objective: the player can stand on the final platform, walk into the generator zone with battery, see the prompt and trigger Victory with E (waiting for the activation sound beat).","lastRunAt":1794612476707.0,"lastRunDurationMs":576.0,"lastRunFramesExecuted":122,"lastRunStatus":"passed","name":"Generator victory objective","type":"gameplay","source":["await harness.goToScene('Level01');","await harness.stepFrames(40);","harness.assert(harness.getObjects('Generator').length === 1, 'Generator exists in Level01');","const p0 = harness.getObjects('Player')[0];","harness.setObjectPosition(p0.id, 1650, 300);","const landed = await harness.stepUntil(() => {","  const p = harness.getObjects('Player')[0];","  const bh = p && p.behaviors.PlatformerObject;","  return !!bh && bh.state.IsOnFloor === true && Math.abs(p.y - 314) < 10;","}, { maxFrames: 300 });","harness.assert(landed, 'player stands on the final generator platform (y=' + harness.getObjects('Player')[0].y.toFixed(0) + ')');","harness.setKeyPressed('Right', true);","const inZone = await harness.stepUntil(() => {","  const p = harness.getObjects('Player')[0];","  return !!p && p.centerX >= 1700 && p.centerX <= 1746;","}, { maxFrames: 300 });","harness.setKeyPressed('Right', false);","await harness.stepFrames(5);","harness.assert(inZone, 'player walked into the generator interaction zone (centerX=' + harness.getObjects('Player')[0].centerX.toFixed(0) + ')');","const prompt = harness.getObjects('GeneratorPrompt')[0];","harness.assert(!!prompt && !prompt.hidden, 'prompt shown in the zone');","const battery = harness.getSceneVariable('Battery');","harness.assert(!!battery && Number(battery.value) > 0, 'battery charged (value=' + (battery && battery.value) + ')');","harness.setKeyPressed('e', true);","await harness.stepFrames(3);","harness.setKeyPressed('e', false);","const won = await harness.stepUntil(() => harness.getSceneName() === 'Victory', { maxFrames: 150 });","harness.assert(won, 'E in the zone with battery reached the Victory scene (allow the activation sound beat, scene=' + harness.getSceneName() + ')');","await harness.stepFrames(10);","harness.assert(harness.getObjects('VictoryTitle').length === 1 && harness.getObjects('VictorySubtitle').length === 1, 'Victory scene shows its title and subtitle');","await harness.takeScreenshot('victory');",""]},{"description":"Generator interaction: no auto-victory, E-key only inside zone, prompt visibility, GameOver intact.","lastRunAt":1794614656086.0,"lastRunDurationMs":970.0,"lastRunFramesExecuted":330,"lastRunStatus":"failed","name":"Generator interaction trigger","type":"gameplay","source":["await harness.goToScene('Level01');","await harness.stepFrames(30);","const p = harness.getObjects('Player')[0];","harness.setObjectPosition(p.id, 1630, 280);","await harness.stepFrames(40);","const landed = harness.getObjects('Player')[0];","harness.assert(landed.behaviors.PlatformerObject.state.IsOnFloor === true, 'Player standing on final platform');","// 1. Walking into/past the generator does NOT auto-trigger victory","harness.setKeyPressed('Right', true);","await harness.stepFrames(60);","harness.setKeyPressed('Right', false);","harness.assert(harness.getSceneName() === 'Level01', 'No automatic victory on approach/collision (scene=' + harness.getSceneName() + ')');","// 2. Jumping near/above the generator does not trigger","harness.setKeyPressed('Space', true);","await harness.stepFrames(15);","harness.setKeyPressed('Space', false);","await harness.stepFrames(60);","harness.assert(harness.getSceneName() === 'Level01', 'No victory from jumping near the generator');","// 3. Walk back into the trigger zone (1700-1745) and check the prompt","harness.setKeyPressed('Left', true);","await harness.stepUntil(() => {","  const q = harness.getObjects('Player')[0];","  return q.x + q.width / 2 >= 1700 && q.x + q.width / 2 <= 1745;","}, { maxFrames: 300 });","harness.setKeyPressed('Left', false);","await harness.stepFrames(5);","harness.assert(harness.getSceneName() === 'Level01', 'Still no auto-victory inside the zone');","const prompt = harness.getObjects('GeneratorPrompt')[0];","harness.assert(prompt && !prompt.hidden, 'Prompt visible while in the interaction zone');","// 4. Pressing E outside the zone does nothing","harness.setObjectPosition(p.id, 1625, 280); // on platform, left of trigger","await harness.stepFrames(40);","harness.setKeyPressed('e', true);","await harness.stepFrames(5);","harness.setKeyPressed('e', false);","await harness.stepFrames(20);","harness.assert(harness.getSceneName() === 'Level01', 'Pressing E outside the zone does nothing');","harness.assert(harness.getObjects('GeneratorPrompt')[0].hidden, 'Prompt hidden outside the zone');","// 5. Pressing E inside the zone with Battery > 0 triggers Victory","harness.setKeyPressed('Right', true);","await harness.stepUntil(() => {","  const q = harness.getObjects('Player')[0];","  return q.x + q.width / 2 >= 1700 && q.x + q.width / 2 <= 1745;","}, { maxFrames: 300 });","harness.setKeyPressed('Right', false);","await harness.stepFrames(5);","harness.assert(!harness.getObjects('GeneratorPrompt')[0].hidden, 'Prompt visible again inside the zone');","harness.setKeyPressed('e', true);","let won = await harness.stepUntil(() => harness.getSceneName() === 'Victory', { maxFrames: 120 });","harness.setKeyPressed('e', false);","harness.assert(won, 'E inside the zone with Battery > 0 triggers Victory');","await harness.takeScreenshot('victory via E');","// 6. Battery depletion still leads to GameOver","await harness.goToScene('Level01');","await harness.stepFrames(10);","harness.setSceneVariable('Battery', 2);","const p2 = harness.getObjects('Player')[0];","harness.setObjectPosition(p2.id, 200, 400);","await harness.stepFrames(10);","let over = await harness.stepUntil(() => harness.getSceneName() === 'GameOver', { maxFrames: 600 });","harness.assert(over, 'Battery depletion still leads to GameOver');"]},{"description":"Generator prompt gating: visible in the zone with battery, hidden outside or at zero battery, E gated correctly, and a clean scene reload confirms E with battery still wins.","lastRunAt":1794547786248.0,"lastRunDurationMs":615.0,"lastRunFramesExecuted":333,"lastRunStatus":"passed","name":"Generator prompt visibility","type":"gameplay","source":["async function goToZone() {","  await harness.stepFrames(40);","  const p0 = harness.getObjects('Player')[0];","  harness.setObjectPosition(p0.id, 1650, 300);","  await harness.stepFrames(50);","  harness.setKeyPressed('Right', true);","  const inZone = await harness.stepUntil(() => {","    const p = harness.getObjects('Player')[0];","    return !!p && p.centerX >= 1700 && p.centerX <= 1746;","  }, { maxFrames: 300 });","  harness.setKeyPressed('Right', false);","  await harness.stepFrames(5);","  return inZone;","}","const promptVisible = () => {","  const pr = harness.getObjects('GeneratorPrompt')[0];","  return !!pr && !pr.hidden;","};","","// --- Scene A: prompt gating rules ---","await harness.goToScene('Level01');","harness.assert(await goToZone(), 'player reached the generator zone');","harness.assert(promptVisible(), '1. Prompt appears inside the zone with Battery > 0');","","// leave the zone (walk left)","harness.setKeyPressed('Left', true);","const leftZone = await harness.stepUntil(() => {","  const p = harness.getObjects('Player')[0];","  return !!p && p.centerX < 1640;","}, { maxFrames: 300 });","harness.setKeyPressed('Left', false);","await harness.stepFrames(5);","harness.assert(leftZone && !promptVisible(), '2. Prompt disappears when the Player leaves the zone');","","harness.setKeyPressed('Right', true);","const backIn = await harness.stepUntil(() => {","  const p = harness.getObjects('Player')[0];","  return !!p && p.centerX >= 1700 && p.centerX <= 1746;","}, { maxFrames: 300 });","harness.setKeyPressed('Right', false);","await harness.stepFrames(5);","harness.assert(backIn && promptVisible(), '3a. Prompt visible again inside the zone');","","harness.setSceneVariable('Battery', 0);","await harness.stepFrames(5);","harness.assert(!promptVisible(), '3b. Prompt hidden when Battery = 0 even inside the zone');","harness.setKeyPressed('e', true);","await harness.stepFrames(4);","harness.setKeyPressed('e', false);","await harness.stepFrames(10);","harness.assert(harness.getSceneName() === 'Level01', '4a. E with Battery = 0 does not trigger Victory');","","// --- Scene B: fresh Level01 (clears the pending battery GameOver) then the real win ---","await harness.goToScene('Level01');","harness.assert(await goToZone(), 'player reached the generator zone on the fresh Level01');","harness.assert(promptVisible(), '4b. Prompt visible inside the zone with Battery restored to 100');","const battery = harness.getSceneVariable('Battery');","harness.assert(!!battery && Number(battery.value) > 0, 'battery charged again after the scene reload (value=' + (battery && battery.value) + ')');","harness.setKeyPressed('e', true);","await harness.stepFrames(4);","harness.setKeyPressed('e', false);","const won = await harness.stepUntil(() => harness.getSceneName() === 'Victory', { maxFrames: 150 });","harness.assert(won, '4c. E inside the zone with Battery > 0 triggers Victory (scene=' + harness.getSceneName() + ')');","await harness.takeScreenshot('victory');",""]},{"description":"Three pickups placed, each collectible independently with +20 battery capped at 100; victory intact.","lastRunAt":1794547787582.0,"lastRunDurationMs":708.0,"lastRunFramesExecuted":259,"lastRunStatus":"passed","name":"Three energy pickups","type":"gameplay","source":["await harness.goToScene('Level01');","await harness.stepFrames(30);","// All three pickups present, original untouched","let pickups = harness.getObjects('EnergyPickup');","harness.assert(pickups.length === 3, 'Three EnergyPickups in Level01 (found ' + pickups.length + ')');","const positions = pickups.map(p => Math.round(p.x) + ',' + Math.round(p.y)).sort().join(' | ');","console.log('Pickups at: ' + positions);","harness.assert(positions.includes('625,287'), 'Original pickup still at (625,287)');","// Collect pickup 1 (original, on floating platform)","const p = harness.getObjects('Player')[0];","harness.setObjectPosition(p.id, 560, 200);","await harness.stepFrames(30);","harness.setKeyPressed('Right', true);","await harness.stepUntil(() => harness.getObjects('EnergyPickup').length === 2, { maxFrames: 300 });","harness.setKeyPressed('Right', false);","await harness.stepFrames(5);","let battery = Number(harness.getSceneVariable('Battery').value);","harness.assert(battery >= 20 && battery <= 100, 'Pickup 1 collected: Battery=' + battery + ' (>=20, <=100)');","// Collect pickup 2 on platform B (top 190): teleport above B, land, walk into it","harness.setObjectPosition(p.id, 1100, 60);","await harness.stepFrames(40);","harness.setKeyPressed('Right', true);","await harness.stepUntil(() => harness.getObjects('EnergyPickup').length === 1, { maxFrames: 300 });","harness.setKeyPressed('Right', false);","await harness.stepFrames(5);","battery = Number(harness.getSceneVariable('Battery').value);","harness.assert(battery >= 40 && battery <= 100, 'Pickup 2 collected: Battery=' + battery + ' (>=40, <=100)');","// Collect pickup 3 on platform C (top 260): teleport above C, land, walk into it","harness.setObjectPosition(p.id, 1380, 130);","await harness.stepFrames(40);","harness.setKeyPressed('Right', true);","await harness.stepUntil(() => harness.getObjects('EnergyPickup').length === 0, { maxFrames: 300 });","harness.setKeyPressed('Right', false);","await harness.stepFrames(5);","battery = Number(harness.getSceneVariable('Battery').value);","harness.assert(battery >= 60 && battery <= 100, 'Pickup 3 collected: Battery=' + battery + ' (>=60, <=100)');","harness.assert(harness.getObjects('EnergyPickup').length === 0, 'All three pickups collected independently');","// Generator interaction + Victory still work","harness.setObjectPosition(p.id, 1630, 280);","await harness.stepFrames(40);","harness.setKeyPressed('Right', true);","await harness.stepUntil(() => {","  const q = harness.getObjects('Player')[0];","  return q.x + q.width / 2 >= 1700 && q.x + q.width / 2 <= 1745;","}, { maxFrames: 300 });","harness.setKeyPressed('Right', false);","await harness.stepFrames(5);","harness.setKeyPressed('e', true);","let won = await harness.stepUntil(() => harness.getSceneName() === 'Victory', { maxFrames: 120 });","harness.setKeyPressed('e', false);","harness.assert(won, 'Generator interaction and Victory still work');","await harness.takeScreenshot('victory after collecting all pickups');"]},{"description":"Dark background applied; pickups and victory unaffected.","lastRunAt":1794612474431.0,"lastRunDurationMs":606.0,"lastRunFramesExecuted":164,"lastRunStatus":"passed","name":"Industrial background color","type":"gameplay","source":["await harness.goToScene('Level01');","await harness.stepFrames(30);","harness.assert(harness.getObjects('EnergyPickup').length === 3, 'Three pickups present');","const p = harness.getObjects('Player')[0];","// Collect ONLY the original pickup: place player just left of it on the floating platform","harness.setObjectPosition(p.id, 560, 200);","await harness.stepFrames(30);","harness.setKeyPressed('Right', true);","await harness.stepUntil(() => harness.getObjects('EnergyPickup').length === 2, { maxFrames: 300 });","harness.setKeyPressed('Right', false);","console.log('after pickup1: count=' + harness.getObjects('EnergyPickup').length + ' battery=' + harness.getSceneVariable('Battery').value);","harness.assert(harness.getObjects('EnergyPickup').length === 2, 'Exactly one pickup collected, two remain');","const battery1 = Number(harness.getSceneVariable('Battery').value);","harness.assert(battery1 >= 20 && battery1 <= 100, 'Battery restored and capped (=' + battery1 + ')');","// Victory still works","harness.setObjectPosition(p.id, 1630, 280);","await harness.stepFrames(40);","harness.setKeyPressed('Right', true);","await harness.stepUntil(() => {","  const q = harness.getObjects('Player')[0];","  return q.x + q.width / 2 >= 1700 && q.x + q.width / 2 <= 1745;","}, { maxFrames: 300 });","harness.setKeyPressed('Right', false);","await harness.stepFrames(5);","harness.setKeyPressed('e', true);","let won = await harness.stepUntil(() => harness.getSceneName() === 'Victory', { maxFrames: 120 });","harness.setKeyPressed('e', false);","harness.assert(won, 'Victory still works after background change');","await harness.takeScreenshot('victory with dark background');"]},{"description":"Two flush mirrored background tiles cover the start, highest platform and generator chamber viewports, the Background layer camera stays synced, and the camera follows past the old 1580 limit up to the new 3720 clamp.","lastRunAt":1794614485927.0,"lastRunDurationMs":518.0,"lastRunFramesExecuted":143,"lastRunStatus":"passed","name":"Industrial background coverage","type":"gameplay","source":["await harness.goToScene('Level01');","await harness.stepFrames(40);","","const list = () => harness.getObjects('PowerStationBackground').slice().sort((a, b) => a.x - b.x);","const bgs = list();","harness.assert(bgs.length === 2, 'two background tiles (got ' + bgs.length + ')');","harness.assert(bgs[0].x === -185 && bgs[0].y === -140 && bgs[0].width === 2430 && bgs[0].height === 810, 'tile 1 at (-185,-140) 2430x810');","harness.assert(bgs[1].x === 2245 && bgs[1].y === -140 && bgs[1].width === 2430 && bgs[1].height === 810, 'tile 2 at (2245,-140) 2430x810');","harness.assert(bgs[0].x + bgs[0].width === bgs[1].x, 'tiles are flush, no gap (' + (bgs[0].x + bgs[0].width) + ' == ' + bgs[1].x + ')');","harness.assert(bgs.every(b => b.layer === 'Background' && !b.hidden), 'both tiles on the Background layer and visible');","harness.assert(bgs[1].x + bgs[1].width >= 4200, 'coverage reaches the new level end at 4200 (reaches ' + (bgs[1].x + bgs[1].width) + ')');","","function coverage(tag) {","  const cam = harness.getCameraState('');","  const l = cam.x - 480, r = cam.x + 480;","  const t = list();","  const spans = t[0].x <= l && t[t.length - 1].x + t[t.length - 1].width >= r;","  harness.assert(spans, tag + ': viewport ' + Math.round(l) + '..' + Math.round(r) + ' fully covered');","  const cb = harness.getCameraState('Background');","  harness.assert(!!cb && Math.abs(cb.x - cam.x) < 1 && Math.abs(cb.y - cam.y) < 1, tag + ': Background layer camera mirrors the gameplay camera');","}","coverage('start');","","// highest platform B","const player = harness.getObjects('Player')[0];","harness.setObjectPosition(player.id, 1120, 40);","const landed = await harness.stepUntil(() => {","  const p = harness.getObjects('Player')[0];","  const bh = p && p.behaviors.PlatformerObject;","  return !!bh && bh.state.IsOnFloor === true;","}, { maxFrames: 400 });","harness.assert(landed, 'player landed on the highest platform');","await harness.stepFrames(40);","coverage('highest platform');","","// generator chamber","harness.setObjectPosition(player.id, 1840, 300);","await harness.stepFrames(2);","await harness.stepUntil(() => {","  const p = harness.getObjects('Player')[0];","  const bh = p && p.behaviors.PlatformerObject;","  return !!bh && bh.state.IsOnFloor === true;","}, { maxFrames: 400 });","await harness.stepFrames(60);","coverage('generator chamber');","const camEnd = harness.getCameraState('');","harness.assert(camEnd.x > 1580, 'camera now follows past the old 1580 limit (x=' + Math.round(camEnd.x) + ') and stays under the new 3720 clamp');","harness.assert(camEnd.x <= 3721, 'camera respects the new 3720 right clamp (x=' + Math.round(camEnd.x) + ')');","","// untouched gameplay","harness.assert(harness.getObjects('EnergyPickup').length <= 3, 'pickups only removed by the player');","harness.assert(harness.getObjects('Generator').length === 1 && harness.getObjects('GeneratorTrigger').length === 1, 'generator group intact');","const hud = harness.getObjects('BatteryText')[0];","harness.assert(!!hud && hud.layer === 'UI' && !hud.hidden, 'HUD still visible on the UI layer');","const p = harness.getObjects('Player')[0];","harness.assert(!!p && p.y < 500, 'player still standing on a platform (y=' + (p && p.y.toFixed(0)) + ')');","await harness.takeScreenshot('generator chamber with tiled background');",""]},{"description":"Fall below the level -> GameOver with SIGNAL LOST; R retries into a fully reset Level01 (Battery 50, 3 pickups, start position, camera/background); battery depletion still shows POWER DEPLETED; generator still wins.","lastRunAt":1794614638415.0,"lastRunDurationMs":1469.0,"lastRunFramesExecuted":492,"lastRunStatus":"passed","name":"Fall detection and retry","type":"gameplay","source":["await harness.goToScene('Level01');","await harness.stepFrames(40);","const startPlayer = harness.getObjects('Player')[0];","const startX = startPlayer.x, startY = startPlayer.y;","let b = harness.getSceneVariable('Battery');","harness.assert(harness.getObjects('EnergyPickup').length === 3, 'three pickups at Level01 start');","harness.assert(Number(b.value) === 50, 'Battery initialised to 50 at scene start (got ' + b.value + ')');","","harness.setKeyPressed('Right', true);","const fell = await harness.stepUntil(() => harness.getSceneName() === 'GameOver', { maxFrames: 600 });","harness.setKeyPressed('Right', false);","harness.assert(fell, 'falling below the level changed to GameOver (scene=' + harness.getSceneName() + ')');","await harness.stepFrames(10);","const fallMsg = (harness.getObjects('GameOverText')[0] || {}).text || '';","harness.assert(fallMsg.indexOf('SIGNAL LOST') === 0, 'fall shows SIGNAL LOST (got ' + JSON.stringify(fallMsg) + ')');","const retryLabel = (harness.getObjects('RetryText')[0] || {}).text || '';","harness.assert(retryLabel.toUpperCase().indexOf('PRESS R TO RETRY') === 0, 'retry instruction visible (got ' + JSON.stringify(retryLabel) + ')');","","harness.setKeyPressed('r', true);","await harness.stepFrames(3);","harness.setKeyPressed('r', false);","await harness.stepFrames(45);","harness.assert(harness.getSceneName() === 'Level01', 'R restarted Level01 (scene=' + harness.getSceneName() + ')');","const p2 = harness.getObjects('Player')[0];","harness.assert(!!p2 && Math.abs(p2.x - startX) < 2 && Math.abs(p2.y - startY) < 3, 'Player back at the normal start (x=' + (p2 && p2.x.toFixed(0)) + ', y=' + (p2 && p2.y.toFixed(0)) + ')');","b = harness.getSceneVariable('Battery');","harness.assert(Number(b.value) >= 49, 'Battery reset to 50 after retry (got ' + (b && b.value) + ')');","harness.assert(harness.getObjects('EnergyPickup').length === 3, 'all three pickups reappeared after retry (got ' + harness.getObjects('EnergyPickup').length + ')');","const cam = harness.getCameraState('');","const bg = harness.getObjects('PowerStationBackground')[0];","harness.assert(!!cam && Math.abs(cam.x - 480) < 3, 'camera back at its start position (x=' + (cam && cam.x) + ')');","harness.assert(!!bg && bg.layer === 'Background' && bg.x <= cam.x - 480 && bg.x + bg.width >= cam.x + 480, 'background still covers the viewport on the Background layer');","","harness.setSceneVariable('Battery', 0);","await harness.stepFrames(5);","const depleted = await harness.stepUntil(() => harness.getSceneName() === 'GameOver', { maxFrames: 400 });","harness.assert(depleted, 'battery depletion still reaches GameOver (delay path intact)');","await harness.stepFrames(10);","const depMsg = (harness.getObjects('GameOverText')[0] || {}).text || '';","harness.assert(depMsg.indexOf('POWER DEPLETED') === 0, 'battery depletion shows POWER DEPLETED (got ' + JSON.stringify(depMsg) + ')');","","harness.setKeyPressed('r', true);","await harness.stepFrames(3);","harness.setKeyPressed('r', false);","await harness.stepFrames(45);","harness.assert(harness.getSceneName() === 'Level01', 'R restarted Level01 after the battery failure (scene=' + harness.getSceneName() + ')');","const p3 = harness.getObjects('Player')[0];","harness.setObjectPosition(p3.id, 1650, 300);","await harness.stepFrames(60);","harness.setKeyPressed('Right', true);","const inZone = await harness.stepUntil(() => {","  const p = harness.getObjects('Player')[0];","  return !!p && p.centerX >= 1700 && p.centerX <= 1746;","}, { maxFrames: 300 });","harness.setKeyPressed('Right', false);","await harness.stepFrames(5);","harness.assert(inZone, 'walked into the generator zone after restart');","harness.setKeyPressed('e', true);","await harness.stepFrames(3);","harness.setKeyPressed('e', false);","const won = await harness.stepUntil(() => harness.getSceneName() === 'Victory', { maxFrames: 150 });","harness.assert(won, 'the generator still triggers Victory (scene=' + harness.getSceneName() + ')');","await harness.takeScreenshot('victory after restart');",""]},{"description":"Audio milestone (re-pointed to S4/S5 geometry): one jump sound per jump, one recharge sound per pickup, one power-down on GameOver, one chime on Victory, generator zap before the Victory change, single non-stacking ambient loop that restarts after retry.","lastRunAt":1794614600444.0,"lastRunDurationMs":1435.0,"lastRunFramesExecuted":647,"lastRunStatus":"passed","name":"Audio feedback and music","type":"gameplay","source":["await harness.goToScene('Level01');","await harness.stepFrames(60);","const log = () => JSON.stringify((harness.getPlayedSounds() || []).map(s => s.sound));","const count = (needle) => (harness.getPlayedSounds() || []).filter(s => String(s.sound).indexOf(needle) >= 0).length;","","harness.assert(count('Extreme Darkness') === 1, 'ambient music started exactly once (count=' + count('Extreme Darkness') + ') log=' + log());","await harness.stepFrames(90);","harness.assert(count('Extreme Darkness') === 1, 'music does not stack over 90 frames');","","const player = () => harness.getObjects('Player')[0];","for (let j = 0; j < 2; j++) {","  harness.setKeyPressed('Space', true);","  await harness.stepFrames(4);","  harness.setKeyPressed('Space', false);","  await harness.stepUntil(() => {","    const p = player();","    const bh = p && p.behaviors.PlatformerObject;","    return !!bh && bh.state.IsOnFloor === true;","  }, { maxFrames: 240 });","  await harness.stepFrames(12);","}","harness.assert(count('Jump 8') === 2, 'two jumps played exactly two jump sounds (count=' + count('Jump 8') + ')');","","// one pickup -> exactly one recharge sound (pickups float during construction: drop through one)","const pickupsBefore = harness.getObjects('EnergyPickup').length;","harness.assert(pickupsBefore === 3, 'three pickups present');","const pk = harness.getObjects('EnergyPickup').find(e => Math.abs(e.x - 625) < 8);","const mid = pk.x + pk.width / 2;","let collected = false;","for (const dx of [0, -20, -40, -60, 20, -80]) {","  harness.setObjectPosition(player().id, mid + dx, 40);","  collected = await harness.stepUntil(() => harness.getObjects('EnergyPickup').length < pickupsBefore, { maxFrames: 40 });","  if (collected) break;","}","harness.assert(collected, 'one pickup collected');","await harness.stepFrames(8);","harness.assert(count('Powerup 4') === 1, 'one collected pickup played exactly one recharge sound (count=' + count('Powerup 4') + ')');","harness.setObjectPosition(player().id, 660, 350);","await harness.stepUntil(() => {","  const q = player();","  const bh = q && q.behaviors.PlatformerObject;","  return !!bh && bh.state.IsOnFloor === true;","}, { maxFrames: 200 });","","harness.setSceneVariable('Battery', 0);","await harness.stepFrames(5);","const over = await harness.stepUntil(() => harness.getSceneName() === 'GameOver', { maxFrames: 400 });","harness.assert(over, 'battery depletion still reaches GameOver');","await harness.stepFrames(25);","harness.assert(count('Lose 1') === 1, 'GameOver power-down played exactly once');","const msg = (harness.getObjects('GameOverText')[0] || {}).text || '';","harness.assert(msg.indexOf('POWER DEPLETED') === 0, 'POWER DEPLETED message intact');","harness.assert(count('Extreme Darkness') === 1, 'music not restarted on the GameOver screen');","","harness.setKeyPressed('r', true);","await harness.stepFrames(3);","harness.setKeyPressed('r', false);","await harness.stepFrames(50);","harness.assert(harness.getSceneName() === 'Level01', 'R restarted Level01');","harness.assert(count('Extreme Darkness') === 2, 'music plays again after the restart, without stacking (count=' + count('Extreme Darkness') + ')');","harness.assert(harness.getObjects('EnergyPickup').length === 3, 'three pickups back after restart');","const bat = harness.getSceneVariable('Battery');","harness.assert(Number(bat.value) >= 49, 'battery reset to 50 after the retry (got ' + (bat && bat.value) + ')');","","const p2 = harness.getObjects('Player')[0];","harness.setObjectPosition(p2.id, 1650, 300);","await harness.stepFrames(60);","harness.setKeyPressed('Right', true);","const inZone = await harness.stepUntil(() => {","  const q = harness.getObjects('Player')[0];","  return !!q && q.centerX >= 1700 && q.centerX <= 1746;","}, { maxFrames: 300 });","harness.setKeyPressed('Right', false);","await harness.stepFrames(5);","harness.assert(inZone, 'walked into the generator zone');","const zapBefore = count('Zap effect');","harness.setKeyPressed('e', true);","await harness.stepFrames(3);","harness.setKeyPressed('e', false);","await harness.stepFrames(20);","harness.assert(count('Zap effect') === zapBefore + 1, 'generator activation sound played once');","harness.assert(harness.getSceneName() === 'Level01', 'scene change deferred so the activation effect is not cut off');","const victory = await harness.stepUntil(() => harness.getSceneName() === 'Victory', { maxFrames: 200 });","harness.assert(victory, 'Victory scene still reached after the activation beat');","await harness.stepFrames(25);","harness.assert(count('Complete_02') === 1, 'victory chime played exactly once');",""]},{"description":"Stage S1 (re-pointed to S4/S5 geometry): starts at 50 battery, drains 1 per 1.5s, pickups add 20 capped at 100 (collected by dropping through them while they float during construction), zero still reaches GameOver, retry resets to 50; HUD tracks the value.","lastRunAt":1794614579085.0,"lastRunDurationMs":895.0,"lastRunFramesExecuted":466,"lastRunStatus":"passed","name":"Battery baseline 50","type":"gameplay","source":["await harness.goToScene('Level01');","await harness.stepFrames(20);","const b0 = Number(harness.getSceneVariable('Battery').value);","harness.assert(b0 === 50, 'Level01 starts with Battery = 50 (got ' + b0 + ')');","const hud0 = (harness.getObjects('BatteryText')[0] || {}).text || '';","harness.assert(hud0.indexOf('50') >= 0, 'HUD shows 50% at start (got ' + JSON.stringify(hud0) + ')');","await harness.stepFrames(200);","const b1 = Number(harness.getSceneVariable('Battery').value);","const drained = b0 - b1;","harness.assert(drained >= 2 && drained <= 3, 'drain is still 1 per 1.5s (' + drained + ' points in ~3.3s, value=' + b1 + ')');","const hud1 = (harness.getObjects('BatteryText')[0] || {}).text || '';","harness.assert(hud1.indexOf(String(Math.round(b1))) >= 0, 'HUD matches the live value (HUD=' + JSON.stringify(hud1) + ')');","","// pickups currently float above the rebuilt platforms: collect by dropping through one","async function fallThroughPickup(pickupX, batteryBefore) {","  harness.setSceneVariable('Battery', batteryBefore);","  await harness.stepFrames(4);","  const pk = harness.getObjects('EnergyPickup').find(e => Math.abs(e.x - pickupX) < 8);","  harness.assert(!!pk, 'pickup at x=' + pickupX + ' exists');","  const mid = pk.x + pk.width / 2;","  for (const dx of [0, -20, -40, -60, 20, -80]) {","    const before = harness.getObjects('EnergyPickup').length;","    harness.setObjectPosition(harness.getObjects('Player')[0].id, mid + dx, 40);","    const got = await harness.stepUntil(() => harness.getObjects('EnergyPickup').length < before, { maxFrames: 40 });","    if (got) { await harness.stepFrames(2); return Number(harness.getSceneVariable('Battery').value); }","  }","  harness.fail('could not collect the pickup at x=' + pickupX);","  return Number(harness.getSceneVariable('Battery').value);","}","","const capped = await fallThroughPickup(625, 95);","harness.assert(capped === 100, 'pickup at ~95 caps at 100 instead of 115 (got ' + capped + ')');","harness.setObjectPosition(harness.getObjects('Player')[0].id, 660, 350);","await harness.stepUntil(() => {","  const q = harness.getObjects('Player')[0];","  const bh = q && q.behaviors.PlatformerObject;","  return !!bh && bh.state.IsOnFloor === true;","}, { maxFrames: 200 });","harness.assert(harness.getSceneName() === 'Level01', 'player recovered onto solid ground after the cap check');","","const after = await fallThroughPickup(1150, 40);","harness.assert(after >= 50 && after <= 78, 'one pickup adds ~20 without hitting the cap (40 -> ' + after + ')');","harness.setObjectPosition(harness.getObjects('Player')[0].id, 660, 350);","await harness.stepUntil(() => {","  const q = harness.getObjects('Player')[0];","  const bh = q && q.behaviors.PlatformerObject;","  return !!bh && bh.state.IsOnFloor === true;","}, { maxFrames: 200 });","harness.assert(harness.getSceneName() === 'Level01', 'player recovered after the +20 check');","","harness.setSceneVariable('Battery', 0);","await harness.stepFrames(5);","const over = await harness.stepUntil(() => harness.getSceneName() === 'GameOver', { maxFrames: 400 });","harness.assert(over, 'Battery 0 still triggers GameOver through the existing 1.5s delay');","await harness.stepFrames(10);","const msg = (harness.getObjects('GameOverText')[0] || {}).text || '';","harness.assert(msg.indexOf('POWER DEPLETED') === 0, 'depletion GameOver message intact (got ' + JSON.stringify(msg) + ')');","","harness.setKeyPressed('r', true);","await harness.stepFrames(3);","harness.setKeyPressed('r', false);","await harness.stepFrames(30);","harness.assert(harness.getSceneName() === 'Level01', 'R restarted Level01 (scene=' + harness.getSceneName() + ')');","const b2 = Number(harness.getSceneVariable('Battery').value);","harness.assert(b2 === 50, 'restart resets Battery to 50 (got ' + b2 + ')');","const hud2 = (harness.getObjects('BatteryText')[0] || {}).text || '';","harness.assert(hud2.indexOf('50') >= 0, 'HUD shows 50% after restart (got ' + JSON.stringify(hud2) + ')');","harness.assert(harness.getObjects('EnergyPickup').length === 3, 'all three pickups restored after restart');","await harness.takeScreenshot('Level01 after restart - 50%');",""]},{"description":"Stage S2+S3: camera clamps at 480 and 3720 through the LevelWidth variable, two mirrored background tiles sit flush and cover the start/mid/far-right viewports, background layer camera stays synced, and gameplay/HUD/battery are untouched.","lastRunAt":1794614641207.0,"lastRunDurationMs":798.0,"lastRunFramesExecuted":166,"lastRunStatus":"passed","name":"Camera bounds and background coverage","type":"gameplay","source":["await harness.goToScene('Level01');","await harness.stepFrames(60);","const cam0 = harness.getCameraState('');","harness.assert(Math.abs(cam0.x - 480) < 2, 'camera clamps at X=480 at the left end (got ' + cam0.x.toFixed(1) + ')');","","const bgs = harness.getObjects('PowerStationBackground').slice().sort((a, b) => a.x - b.x);","harness.assert(bgs.length === 2, 'exactly two background instances (got ' + bgs.length + ')');","harness.assert(bgs[0].x === -185 && bgs[0].y === -140 && bgs[0].width === 2430 && bgs[0].height === 810, 'first instance unchanged at (-185,-140) 2430x810');","harness.assert(bgs[1].x === 2245 && bgs[1].y === -140 && bgs[1].width === 2430 && bgs[1].height === 810, 'second instance at (2245,-140) 2430x810');","harness.assert(bgs[0].x + bgs[0].width === bgs[1].x, 'no gap: first right edge ' + (bgs[0].x + bgs[0].width) + ' == second left edge ' + bgs[1].x);","harness.assert(bgs[0].y === bgs[1].y && bgs[0].height === bgs[1].height, 'tiles share the same vertical extent (edges align)');","harness.assert(bgs[0].layer === 'Background' && bgs[1].layer === 'Background', 'both instances on the Background layer');","harness.assert(Math.abs(bgs[0].width / bgs[0].height - bgs[1].width / bgs[1].height) < 0.001, 'both tiles share the same aspect ratio (no differential stretching)');","","function coverage(tag, camX) {","  const list = harness.getObjects('PowerStationBackground').slice().sort((a, b) => a.x - b.x);","  const left = camX - 480, right = camX + 480;","  const spans = list[0].x <= left && list[list.length - 1].x + list[list.length - 1].width >= right;","  let contiguous = true;","  for (let i = 1; i < list.length; i++) {","    if (Math.abs((list[i - 1].x + list[i - 1].width) - list[i].x) > 0.5) contiguous = false;","  }","  harness.assert(spans && contiguous, tag + ': viewport ' + Math.round(left) + '..' + Math.round(right) + ' fully covered, tiles contiguous (spans=' + spans + ', contiguous=' + contiguous + ')');","  const cb = harness.getCameraState('Background');","  const c = harness.getCameraState('');","  harness.assert(!!cb && Math.abs(cb.x - c.x) < 1 && Math.abs(cb.y - c.y) < 1, tag + ': Background layer camera mirrors the gameplay camera');","}","coverage('start', cam0.x);","await harness.takeScreenshot('background - start area');","","const p = harness.getObjects('Player')[0];","harness.setObjectPosition(p.id, 1950, 300);","await harness.stepFrames(70);","const camMid = harness.getCameraState('');","const pm = harness.getObjects('Player')[0];","harness.assert(harness.getSceneName() === 'Level01', 'player stayed alive during the mid-level check');","harness.assert(Math.abs(camMid.x - pm.centerX) < 6, 'camera follows the player mid-level (cam=' + Math.round(camMid.x) + ', player=' + Math.round(pm.centerX) + ')');","harness.assert(camMid.x > 480 && camMid.x < 3720, 'mid-level camera is unclamped (' + Math.round(camMid.x) + ')');","coverage('seam region', camMid.x);","await harness.takeScreenshot('background - seam region (mid)');","","const p2 = harness.getObjects('Player')[0];","harness.setObjectPosition(p2.id, 3900, -200);","const reached = await harness.stepUntil(() => Math.abs(harness.getCameraState('').x - 3720) < 3, { maxFrames: 70 });","const camRight = harness.getCameraState('');","harness.assert(reached, 'camera eased to the right clamp 3720 (got ' + camRight.x.toFixed(1) + ')');","harness.assert(camRight.x <= 3721, 'camera never exceeds 4200 - 480 = 3720 (got ' + camRight.x.toFixed(1) + ')');","coverage('far right', camRight.x);","await harness.takeScreenshot('background - far right');","","const hud = harness.getObjects('BatteryText')[0];","harness.assert(!!hud && hud.layer === 'UI' && !hud.hidden, 'HUD still on the UI layer and visible');","harness.assert(((hud || {}).text || '').indexOf('BATTERY') === 0, 'HUD still renders the battery label (got ' + JSON.stringify((hud || {}).text) + ')');","harness.assert(harness.getObjects('EnergyPickup').length === 3, 'three pickups untouched');","harness.assert(harness.getObjects('Generator').length === 1 && harness.getObjects('GeneratorTrigger').length === 1, 'generator group untouched');","const b = harness.getSceneVariable('Battery');","harness.assert(Number(b.value) <= 50 && Number(b.value) >= 40, 'battery still starts at 50 (now ' + (b && b.value) + ')');","const lw = harness.getSceneVariable('LevelWidth');","harness.assert(!!lw && Number(lw.value) === 4200, 'LevelWidth scene variable is 4200 (got ' + (lw && lw.value) + ')');",""]},{"description":"Stage S4: from the real start the Player traverses M1->M2->M3->M4->M5 walking (no sprint), can drop into the optional alcove O1 from M3 and climb out to M5 from the alcove's right edge; camera and background stay synced.","lastRunAt":1794614251461.0,"lastRunDurationMs":1113.0,"lastRunFramesExecuted":648,"lastRunStatus":"passed","name":"S4 maintenance entrance","type":"gameplay","source":["await harness.goToScene('Level01');","await harness.stepFrames(40);","const FOOT = 86;","const PL = {","  M1: { l: -1, r: 539, top: 475 },","  M2: { l: 600, r: 740, top: 400 },","  M3: { l: 815, r: 935, top: 340 },","  M4: { l: 1035, r: 1135, top: 265 },","  M5: { l: 1260, r: 1410, top: 390 },","  O1: { l: 1010, r: 1140, top: 470 },","};","const player0 = harness.getObjects('Player')[0];","harness.assert(!!player0 && Math.abs(player0.y - (PL.M1.top - FOOT)) < 6, 'player starts and lands on M1 (y=' + (player0 && player0.y.toFixed(0)) + ')');","harness.assert(harness.getObjects('Ground').length === 7, 'S4 platform count is 7 (M1-M5, O1, temporary old generator floor), got ' + harness.getObjects('Ground').length);","","async function hop(S, T, label, opts) {","  opts = opts || {};","  let jumpHold = 0, jumpCool = 0, lastCx = -1e9, noProgress = 0, reached = false;","  const restY = T.top - FOOT;","  const targetX = Math.max(T.l + 40, Math.min(T.r - 40, (T.l + T.r) / 2));","  let speedMax = 0, prevX = null, landedOn = null;","  for (let i = 0; i < 900 && !reached; i++) {","    await harness.stepFrames(1);","    const p = harness.getObjects('Player')[0];","    if (!p || harness.getSceneName() !== 'Level01') { harness.fail(label + ': player lost'); return; }","    const bh = p.behaviors.PlatformerObject;","    const onFloor = !!(bh && bh.state.IsOnFloor !== false);","    const cx = p.centerX;","    if (onFloor && prevX !== null) speedMax = Math.max(speedMax, Math.abs(p.x - prevX) * 60);","    prevX = p.x;","    if (onFloor && Math.abs(p.y - restY) < 7 && cx > T.l - 20 && cx < T.r + 20) { reached = true; break; }","    if (p.y > 740) { harness.fail(label + ': fell out of the level'); return; }","    const dx = targetX - cx;","    if (Math.abs(cx - lastCx) > 8) { lastCx = cx; noProgress = 0; } else noProgress++;","    if (dx > 14) { harness.setKeyPressed('Right', true); harness.setKeyPressed('Left', false); }","    else if (dx < -14) { harness.setKeyPressed('Left', true); harness.setKeyPressed('Right', false); }","    else { harness.setKeyPressed('Right', false); harness.setKeyPressed('Left', false); }","    if (opts.noJump) { harness.setKeyPressed('Space', false); }","    else if (jumpHold > 0) { harness.setKeyPressed('Space', true); jumpHold--; if (!jumpHold) { harness.setKeyPressed('Space', false); jumpCool = 14; } }","    else if (jumpCool > 0) jumpCool--;","    else if (onFloor) {","      const nearEdge = opts.edgeLaunch ? (dx > 0 ? cx >= S.r - 12 : cx <= S.l + 12) : Math.abs(cx - (dx > 0 ? S.r : S.l)) < 95;","      if (nearEdge || noProgress > 70) jumpHold = 12;","    }","  }","  harness.setKeyPressed('Right', false); harness.setKeyPressed('Left', false); harness.setKeyPressed('Space', false);","  harness.assert(reached, label + ' reached');","  if (opts.sampleSpeed) harness.assert(speedMax < 320, label + ': ground speed stayed at walking pace, no sprint (max ' + Math.round(speedMax) + ' px/s)');","  const p = harness.getObjects('Player')[0];","  console.log(label + ' -> x=' + (p && p.x.toFixed(0)) + ' y=' + (p && p.y.toFixed(0)) + ' (surface ' + T.top + ')');","  await harness.stepFrames(4);","}","","// --- primary route from the real start, walking only (Shift never pressed) ---","await hop(PL.M1, PL.M2, 'M1 -> M2', { sampleSpeed: true });","await hop(PL.M2, PL.M3, 'M2 -> M3');","await hop(PL.M3, PL.M4, 'M3 -> M4 (100px landing)');","await hop(PL.M4, PL.M5, 'M4 -> M5 (drop)');","await harness.takeScreenshot('S4 - end of primary route (M5)');","","const cam = harness.getCameraState('');","const cb = harness.getCameraState('Background');","const tiles = harness.getObjects('PowerStationBackground').slice().sort((a, b) => a.x - b.x);","harness.assert(!!cb && Math.abs(cb.x - cam.x) < 1 && Math.abs(cb.y - cam.y) < 1, 'Background layer camera still mirrors the gameplay camera');","harness.assert(tiles[0].x <= cam.x - 480 && tiles[tiles.length - 1].x + tiles[tiles.length - 1].width >= cam.x + 480, 'background still covers the viewport at M5');","","// --- optional alcove route: walk off M3 into O1, then climb out from O1's right edge ---","await harness.goToScene('Level01');","await harness.stepFrames(40);","await hop(PL.M1, PL.M2, 'O1 route: M1 -> M2');","await hop(PL.M2, PL.M3, 'O1 route: M2 -> M3');","await hop(PL.M3, PL.O1, 'M3 -> O1 (walk off the edge, no jump)', { noJump: true });","await harness.takeScreenshot('S4 - service alcove O1');","await hop(PL.O1, PL.M5, 'O1 -> M5 (launch from the alcove right edge)', { edgeLaunch: true });","await harness.takeScreenshot('S4 - back on the main route (M5)');",""]},{"description":"Stage S5: full walking route from the real start through the shaft; M8 arc measured chained and settled with apex screenshots; camera step instrumentation; no reliance on the temporary old generator floor.","lastRunAt":1794614388974.0,"lastRunDurationMs":997.0,"lastRunFramesExecuted":937,"lastRunStatus":"passed","name":"S5 collapsed shaft","type":"gameplay","source":["await harness.goToScene('Level01');","await harness.stepFrames(40);","const FOOT = 86;","const PL = {","  M1: { l: -1, r: 539, top: 475 }, M2: { l: 600, r: 740, top: 400 }, M3: { l: 815, r: 935, top: 340 },","  M4: { l: 1035, r: 1135, top: 265 }, M5: { l: 1260, r: 1410, top: 390 }, M6: { l: 1540, r: 1660, top: 290 },","  M7: { l: 1725, r: 1820, top: 215 }, M8: { l: 1920, r: 2005, top: 165 }, M9: { l: 2130, r: 2240, top: 240 },","  M10: { l: 2440, r: 2660, top: 390 },","};","harness.assert(harness.getObjects('Ground').length === 12, 'S5: 12 Ground instances (got ' + harness.getObjects('Ground').length + ')');","let tempFloorHits = 0, maxCamDx = 0, maxCamDy = 0, prevCam = null, worstDyContext = '';","","async function hop(S, T, label, sampleSpeed) {","  let jumpHold = 0, jumpCool = 0, lastCx = -1e9, noProgress = 0, reached = false;","  const restY = T.top - FOOT;","  const targetX = Math.max(T.l + 40, Math.min(T.r - 40, (T.l + T.r) / 2));","  let speedMax = 0, prevX = null;","  for (let i = 0; i < 900 && !reached; i++) {","    await harness.stepFrames(1);","    const p = harness.getObjects('Player')[0];","    if (!p || harness.getSceneName() !== 'Level01') { harness.fail(label + ': player lost'); return; }","    const bh = p.behaviors.PlatformerObject;","    const onFloor = !!(bh && bh.state.IsOnFloor !== false);","    const cx = p.centerX;","    const cam = harness.getCameraState('');","    if (prevCam) {","      const dy = Math.abs(cam.y - prevCam.y);","      maxCamDx = Math.max(maxCamDx, Math.abs(cam.x - prevCam.x));","      if (dy > maxCamDy) { maxCamDy = dy; worstDyContext = label + ' frame ' + i + ': camY ' + prevCam.y.toFixed(0) + '->' + cam.y.toFixed(0) + ', playerY=' + p.y.toFixed(0) + ', onFloor=' + onFloor; }","    }","    prevCam = cam;","    if (onFloor && p.x > 1500 && Math.abs(p.y - 314) < 7) tempFloorHits++;","    if (onFloor && prevX !== null) speedMax = Math.max(speedMax, Math.abs(p.x - prevX) * 60);","    prevX = p.x;","    if (onFloor && Math.abs(p.y - restY) < 7 && cx > T.l - 20 && cx < T.r + 20) { reached = true; break; }","    if (p.y > 740) { harness.fail(label + ': fell out of the level'); return; }","    const dx = targetX - cx;","    if (Math.abs(cx - lastCx) > 8) { lastCx = cx; noProgress = 0; } else noProgress++;","    if (dx > 14) { harness.setKeyPressed('Right', true); harness.setKeyPressed('Left', false); }","    else if (dx < -14) { harness.setKeyPressed('Left', true); harness.setKeyPressed('Right', false); }","    else { harness.setKeyPressed('Right', false); harness.setKeyPressed('Left', false); }","    if (jumpHold > 0) { harness.setKeyPressed('Space', true); jumpHold--; if (!jumpHold) { harness.setKeyPressed('Space', false); jumpCool = 14; } }","    else if (jumpCool > 0) jumpCool--;","    else if (onFloor) {","      if (Math.abs(cx - (dx > 0 ? S.r : S.l)) < 95 || noProgress > 70) jumpHold = 12;","    }","  }","  harness.setKeyPressed('Right', false); harness.setKeyPressed('Left', false); harness.setKeyPressed('Space', false);","  harness.assert(reached, label + ' reached (surface ' + T.top + ')');","  if (sampleSpeed) harness.assert(speedMax < 320, label + ': walking pace only, no sprint (max ' + Math.round(speedMax) + ' px/s)');","  await harness.stepFrames(4);","}","","async function arcFromM8(frames, shot) {","  let best = 9999;","  harness.setKeyPressed('Space', true);","  for (let i = 0; i < frames; i++) {","    await harness.stepFrames(1);","    if (i === 12) harness.setKeyPressed('Space', false);","    if (shot && i === 26) await harness.takeScreenshot(shot);","    const q = harness.getObjects('Player')[0];","    const c = harness.getCameraState('');","    best = Math.min(best, q.centerY - q.height / 2 - (c.y - 270));","  }","  harness.setKeyPressed('Space', false);","  return best;","}","","await hop(PL.M1, PL.M2, 'M1 -> M2', true);","await hop(PL.M2, PL.M3, 'M2 -> M3');","await hop(PL.M3, PL.M4, 'M3 -> M4');","await hop(PL.M4, PL.M5, 'M4 -> M5');","await hop(PL.M5, PL.M6, 'M5 -> M6 (130 gap, +100 climb)', true);","await hop(PL.M6, PL.M7, 'M6 -> M7');","await hop(PL.M7, PL.M8, 'M7 -> M8');","","await harness.stepFrames(6);","const chained = await arcFromM8(70, 'S5 - near apex, chained jump');","await harness.stepFrames(80);","const settled = await arcFromM8(70, 'S5 - near apex, settled jump');","console.log('arc margins: chained=' + chained.toFixed(0) + 'px settled=' + settled.toFixed(0) + 'px (0 = sprite box top at screen top)');","harness.assert(settled >= 0, 'settled jump from M8 keeps the whole sprite box on screen (' + settled.toFixed(0) + 'px)');","harness.assert(chained >= -6, 'chained jump from M8 clips at most a few px of the sprite box, art stays visible (' + chained.toFixed(0) + 'px)');","await harness.stepFrames(40);","harness.assert(harness.getSceneName() === 'Level01', 'alive on M8 after the arc tests');","","await hop(PL.M8, PL.M9, 'M8 -> M9');","await hop(PL.M9, PL.M10, 'M9 -> M10 (200px gap + 150 drop)');","await harness.takeScreenshot('S5 - landed on M10');","","console.log('worst vertical camera step: ' + maxCamDy.toFixed(1) + ' px/frame at [' + worstDyContext + ']');","harness.assert(tempFloorHits === 0, 'no progress relied on the temporary old generator floor (contacts: ' + tempFloorHits + ')');","harness.assert(maxCamDx < 12, 'no horizontal camera snapping (max ' + maxCamDx.toFixed(1) + ' px/frame)');","harness.assert(maxCamDy < 80, 'vertical camera steps stay within the existing smoothed follow budget (max ' + maxCamDy.toFixed(1) + ' px/frame)');","const cam = harness.getCameraState('');","const cb = harness.getCameraState('Background');","const tiles = harness.getObjects('PowerStationBackground').slice().sort((a, b) => a.x - b.x);","harness.assert(!!cb && Math.abs(cb.x - cam.x) < 1 && Math.abs(cb.y - cam.y) < 1, 'Background layer camera still mirrors the gameplay camera at M10');","harness.assert(tiles[0].x <= cam.x - 480 && tiles[tiles.length - 1].x + tiles[tiles.length - 1].width >= cam.x + 480, 'background still covers the viewport at M10');",""]}],"testsFolderStructure":{"folderName":"__ROOT","children":[{"itemName":"Player platformer controls"},{"itemName":"Player animation states"},{"itemName":"Energy pickup collection"},{"itemName":"Camera follow and HUD"},{"itemName":"Vertical camera dead zone"},{"itemName":"Smoothed camera and jump arc visibility"},{"itemName":"Generator victory objective"},{"itemName":"Generator interaction trigger"},{"itemName":"Generator prompt visibility"},{"itemName":"Three energy pickups"},{"itemName":"Industrial background color"},{"itemName":"Industrial background coverage"},{"itemName":"Fall detection and retry"},{"itemName":"Audio feedback and music"},{"itemName":"Battery baseline 50"},{"itemName":"Camera bounds and background coverage"},{"itemName":"S4 maintenance entrance"},{"itemName":"S5 collapsed shaft"}]},"eventsFunctionsExtensions":[],"externalLayouts":[],"externalLayoutsFolderStructure":{"folderName":"__ROOT"}}